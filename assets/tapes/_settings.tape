# Shared settings: your kitty font, a 16:9-ish frame.
Set Shell "zsh"
# the name starts with a digit, so it must be quoted inside the CSS value
Set FontFamily `"0xProto Nerd Font Mono"`
Set FontSize 16
Set LetterSpacing 0
Set LineHeight 1.0
Set Width 1400
Set Height 820
Set Padding 0
Set Margin 0
Set TypingSpeed 75ms
Set CursorBlink false
